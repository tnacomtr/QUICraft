# Gradle
.gradle/
build/
.kotlin/
# IDEs
.idea/
*.iml
.vscode/
out/
# Fabric Loom / NeoForge: decompiled or remapped Minecraft sources and game files
# (Mojang's, never committed; see CLAUDE.md "Start from scratch").
run/
.minecraft/
**/genSources/
*-sources.jar
# Testkit: raw run output (summaries go to docs/benchmarks.md)
testkit/results/
# Patched Netty QUIC build (natives/build-linux.sh): sources, caches and jars, never committed
natives/build/

# Claude Code agent worktrees
.claude/worktrees/

# Isolated OpenCode agent worktrees
.worktrees/
fabric-*/logs/

# Antigravity subagent run logs (transient; see antigravity-subagent skill)
.agents/antigravity-runs/

# Signing keys: only public keys are ever tracked. Private keys stay offline with the owner.
pubkeys/*
!pubkeys/*.pub.pem
*.key
*private*.pem
*.sec.pem
