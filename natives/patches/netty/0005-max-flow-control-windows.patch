 package io.netty.handler.codec.quic;
 
@@ -155,6 +156,36 @@ public final class Quic {
         }
     }
 
+    /**
+     * Returns {@code true} if the loaded native library can set quiche's maximum flow-control
+     * windows (see {@link QuicCodecBuilder#maxConnectionWindow(long)} and
+     * {@link QuicCodecBuilder#maxStreamWindow(long)}). A native library built without those
+     * bindings returns {@code false}.
+     *
+     * @return {@code true} if supported, {@code false} otherwise.
+     */
+    public static boolean isMaxFlowControlWindowsSupported() {
+        return isAvailable() && MaxFlowControlWindowsSupport.SUPPORTED;
+    }
+
+    private static final class MaxFlowControlWindowsSupport {
+        static final boolean SUPPORTED = probe();
+
+        private static boolean probe() {
+            long config = Quiche.quiche_config_new(Quiche.QUICHE_PROTOCOL_VERSION);
+            try {
+                // quiche's own defaults, so the probe changes nothing even if the config were reused.
+                Quiche.quiche_config_set_max_connection_window(config, 24L * 1024 * 1024);
+                Quiche.quiche_config_set_max_stream_window(config, 16L * 1024 * 1024);
+                return true;
+            } catch (UnsatisfiedLinkError e) {
+                return false;
+            } finally {
+                Quiche.quiche_config_free(config);
+            }
+        }
+    }
+
     static Map.Entry<ChannelOption<?>, Object>[] toOptionsArray(Map<ChannelOption<?>, Object> opts) {
         return new HashMap<>(opts).entrySet().toArray(EMPTY_OPTION_ARRAY);
     }
