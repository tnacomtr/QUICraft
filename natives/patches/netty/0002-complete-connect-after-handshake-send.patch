+ *
+ * Modified by the QUICraft project:
+ * completes a client connect as soon as connectionSend(...) finishes the handshake.
  */
 package io.netty.handler.codec.quic;
 
@@ -1168,6 +1171,7 @@ final class QuicheQuicChannel extends AbstractChannel implements QuicChannel {
             // If we had called recv we need to ensure we call send as well.
             // See https://docs.rs/quiche/0.6.0/quiche/struct.Connection.html#method.send
             connectionSend(conn);
+            completeConnectIfEstablished(conn);
 
             // We are done with the read loop, flush all pending writes now.
             forceFlushParent();
@@ -1206,6 +1210,31 @@ final class QuicheQuicChannel extends AbstractChannel implements QuicChannel {
         } while ((task = conn.sslTask()) != null);
     }
 
+    /**
+     * A client's handshake can finish inside {@link #connectionSend(QuicheQuicConnection)}: quiche resumes a
+     * handshake that paused for a certificate verification task only when it is next driven, and that is the send
+     * after the task ran. Nothing else checks for an established connection until the peer's next packet arrives,
+     * which delays the connect by one round trip. Completes the connect in a task on this event loop instead: it
+     * runs right after the current read or send, without waiting for the peer, and outside of it, so connect
+     * listeners never run inside connectionSend (one that closes the connection there made the send loop spin).
+     */
+    private void completeConnectIfEstablished(QuicheQuicConnection conn) {
+        if (server || connectPromise == null || conn.isFreed()
+                || !Quiche.quiche_conn_is_established(conn.address())) {
+            return;
+        }
+        eventLoop().execute(() -> {
+            if (connectPromise == null || conn.isFreed() || !isOpen()) {
+                return;
+            }
+            ((QuicChannelUnsafe) unsafe()).processReceived(conn);
+            // Send what channelActive and the connect listeners produced.
+            if (!conn.isFreed() && connectionSend(conn) != SendResult.NONE) {
+                forceFlushParent();
+            }
+        });
+    }
+
     private Runnable decorateTaskSend(QuicheQuicConnection conn, Runnable task) {
         return () -> {
             try {
@@ -1217,6 +1246,7 @@ final class QuicheQuicChannel extends AbstractChannel implements QuicChannel {
                     if (connectionSend(conn) != SendResult.NONE) {
                         forceFlushParent();
                     }
+                    completeConnectIfEstablished(conn);
                     freeIfClosed();
                 });
             }
@@ -1491,6 +1521,7 @@ final class QuicheQuicChannel extends AbstractChannel implements QuicChannel {
                             if (connectionSend(conn) != SendResult.NONE) {
                                 forceFlushParent();
                             }
+                            completeConnectIfEstablished(conn);
                             freeIfClosed();
                         }
                     });
@@ -1841,6 +1872,7 @@ final class QuicheQuicChannel extends AbstractChannel implements QuicChannel {
                             if (connectionSend(conn) != SendResult.NONE) {
                                 forceFlushParent();
                             }
+                            completeConnectIfEstablished(conn);
 
                             freeIfClosed();
                         }
