  */
 package io.netty.handler.codec.quic;
 
@@ -99,6 +102,33 @@ public final class Quic {
         return UNAVAILABILITY_CAUSE;
     }
 
+    /**
+     * Returns {@code true} if the loaded native library can set quiche's
+     * {@code enable_relaxed_loss_threshold} (see {@link QuicCodecBuilder#relaxedLossThreshold(boolean)}).
+     * A native library built without that binding returns {@code false}.
+     *
+     * @return {@code true} if supported, {@code false} otherwise.
+     */
+    public static boolean isRelaxedLossThresholdSupported() {
+        return isAvailable() && RelaxedLossThresholdSupport.SUPPORTED;
+    }
+
+    private static final class RelaxedLossThresholdSupport {
+        static final boolean SUPPORTED = probe();
+
+        private static boolean probe() {
+            long config = Quiche.quiche_config_new(Quiche.QUICHE_PROTOCOL_VERSION);
+            try {
+                Quiche.quiche_config_set_enable_relaxed_loss_threshold(config, false);
+                return true;
+            } catch (UnsatisfiedLinkError e) {
+                return false;
+            } finally {
+                Quiche.quiche_config_free(config);
+            }
+        }
+    }
+
     static Map.Entry<ChannelOption<?>, Object>[] toOptionsArray(Map<ChannelOption<?>, Object> opts) {
         return new HashMap<>(opts).entrySet().toArray(EMPTY_OPTION_ARRAY);
     }
