+    /**
+     * See
+     * <a href="https://docs.rs/quiche/latest/quiche/struct.Config.html#method.set_enable_relaxed_loss_threshold">
+     *     set_enable_relaxed_loss_threshold</a>.
+     *
+     * Configures whether loss detection relaxes its thresholds after a spurious loss (packet reordering): the
+     * packet threshold is dropped on the first spurious loss and the time threshold doubles on each further one,
+     * up to twice the RTT. In quiche 0.30 only the BBR (gcongestion) recovery implements it.
+     *
+     * The default value is {@code false}.
+     *
+     * @param enable  {@code true} if relaxed loss thresholds should be enabled.
+     * @return        the instance itself.
+     * @throws UnsupportedOperationException if {@link Quic#isRelaxedLossThresholdSupported()} is {@code false}.
+     */
+    public final B relaxedLossThreshold(boolean enable) {
+        if (!Quic.isRelaxedLossThresholdSupported()) {
+            throw new UnsupportedOperationException(
+                    "the loaded QUIC native library has no relaxed loss threshold binding");
+        }
+        this.enableRelaxedLossThreshold = enable;
+        return self();
+    }
