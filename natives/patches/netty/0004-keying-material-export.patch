+// Exists so the JNI binding for the TLS exporter can be probed without a connection: calling
+// SSL_export_keying_material needs an SSL with a completed handshake, which a capability probe has
+// none of. A native library built without this patch leaves both methods unbound.
+jboolean netty_boringssl_SSL_export_keying_material_supported(JNIEnv* env, jclass clazz) {
+    return JNI_TRUE;
+}
+
+// BoringSSL's SSL_export_keying_material for RFC 8446 section 7.5 (the normal exporter) and
+// RFC 5705, with the context always supplied: use_context is 1, so an empty context is a
+// zero-length context and never an absent one. Returns the exported bytes, or NULL if the export
+// failed, e.g. before the handshake has completed.
+//
+// empty_context stands in for a context of length 0, so BoringSSL never gets a NULL pointer for a
+// context it was told to use.
+static const uint8_t empty_context = 0;
+
+jobject netty_boringssl_SSL_export_keying_material(JNIEnv* env, jclass clazz, jlong ssl, jbyteArray label, jbyteArray context, jint length) {
+    jsize labelLen;
+    jsize contextLen = 0;
+    jbyte* labelBytes;
+    jbyte* contextBytes = NULL;
+    uint8_t* out;
+    jobject result = NULL;
+
+    if (ssl == 0 || label == NULL || length <= 0) {
+        return NULL;
+    }
+    labelLen = (*env)->GetArrayLength(env, label);
+    labelBytes = (*env)->GetByteArrayElements(env, label, NULL);
+    if (labelBytes == NULL) {
+        return NULL;
+    }
+    if (context != NULL) {
+        contextLen = (*env)->GetArrayLength(env, context);
+        if (contextLen > 0) {
+            contextBytes = (*env)->GetByteArrayElements(env, context, NULL);
+            if (contextBytes == NULL) {
+                goto done;
+            }
+        }
+    }
+    out = malloc((size_t) length);
+    if (out == NULL) {
+        goto done;
+    }
+    if (SSL_export_keying_material((const SSL*) ssl, out, (size_t) length, (const char*) labelBytes,
+                                   (size_t) labelLen,
+                                   contextBytes != NULL ? (const uint8_t*) contextBytes : &empty_context,
+                                   (size_t) contextLen, 1) == 1) {
+        jbyteArray exported = (*env)->NewByteArray(env, length);
+        if (exported != NULL) {
+            (*env)->SetByteArrayRegion(env, exported, 0, length, (const jbyte*) out);
+            result = exported;
+        }
+    }
+    OPENSSL_cleanse(out, (size_t) length);
+    free(out);
+
+done:
+    if (contextBytes != NULL) {
+        (*env)->ReleaseByteArrayElements(env, context, contextBytes, JNI_ABORT);
+    }
+    (*env)->ReleaseByteArrayElements(env, label, labelBytes, JNI_ABORT);
+    return result;
+}
