+    /**
+     * A server that accepted 0-RTT can read early stream data before the handshake completes, but its channel
+     * becomes active, and so starts reading streams, only once the handshake is established. And when the client's
+     * 0-RTT packet arrives right behind its Initial, it often comes in before the server's handshake task has
+     * installed the 0-RTT key: quiche buffers it and decrypts it in its next send() after that task, where nothing
+     * looks for readable streams until the client's next packet, one round trip later. After each such send, a
+     * server that is in early data processes what it received in a task on this event loop: channelActive (see
+     * handlePendingChannelActive) and the readable streams. Whether to act on early data before the handshake
+     * completes is up to the application; SslHandshakeCompletionEvent still fires only when it has completed.
+     */
+    private void readEarlyDataIfAccepted(QuicheQuicConnection conn) {
+        if (!server || conn.isFreed() || !Quiche.quiche_conn_is_in_early_data(conn.address())) {
+            return;
+        }
+        eventLoop().execute(() -> {
+            if (conn.isFreed() || !isOpen()) {
+                return;
+            }
+            ((QuicChannelUnsafe) unsafe()).processReceived(conn);
+            // Send what channelActive and the stream handlers produced.
+            if (!conn.isFreed() && connectionSend(conn) != SendResult.NONE) {
+                forceFlushParent();
+            }
+        });
+    }
