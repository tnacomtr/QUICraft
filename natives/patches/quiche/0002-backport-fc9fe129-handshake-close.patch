QUICraft patch for cloudflare/quiche be47c5011215b9f13bad06bd7627d3ae49888a19 (0.30.0): backport
of upstream commit fc9fe129da22ee6f9a2ad3a5fbe1b1d2ab9fc007 ("skip PING ACKs during handshake
close", 2026-09-25), unchanged.

Without it, a client that closes the connection with an application close after the handshake
completed but before the server's HANDSHAKE_DONE never sends its CONNECTION_CLOSE: quiche keeps
producing ACK-only Handshake packets and quiche_conn_send never returns DONE, so Netty's send
loop spins and starves its event loop. QUICraft's connect fix (netty/0002) completes the connect
in exactly that window, and a QUIC attempt that lost the race to TCP closes right away.

Applied by natives/build-netty-quic.sh with `git apply`, which ignores this text.

diff --git a/quiche/src/lib.rs b/quiche/src/lib.rs
index 9a463759..11a00a42 100644
--- a/quiche/src/lib.rs
+++ b/quiche/src/lib.rs
@@ -4540,7 +4540,8 @@ impl<F: BufFactory> Connection<F> {
 
         // Whether a PING frame must explicitly elicit an ACK when no other
         // frame does so implicitly.
-        let ack_elicit_required = path.recovery.should_elicit_ack(epoch);
+        let ack_elicit_required =
+            !is_closing && path.recovery.should_elicit_ack(epoch);
 
         let header_offset = b.off();
 
@@ -4567,6 +4568,9 @@ impl<F: BufFactory> Connection<F> {
         // generate an ACK (if there's anything to ACK) since we're going to
         // send a packet with PING anyways, even if we haven't received anything
         // ACK eliciting.
+        //
+        // While closing, PING frames are suppressed, so ACK elicitation must
+        // not generate ACK-only packets.
         if pkt_space.recv_pkt_need_ack.len() > 0 &&
             (pkt_space.ack_elicited || ack_elicit_required) &&
             (!is_closing ||
@@ -8256,6 +8260,17 @@ impl<F: BufFactory> Connection<F> {
             return Ok(Type::from_epoch(epoch));
         }
 
+        // APPLICATION_CLOSE can only be sent in a 1-RTT packet. Prioritize it
+        // over obsolete lower-epoch PTO probes, which cannot be consumed while
+        // closing because PING frames are suppressed.
+        if self.is_established() &&
+            self.local_error
+                .as_ref()
+                .is_some_and(|conn_err| conn_err.is_app)
+        {
+            return Ok(Type::Short);
+        }
+
         for &epoch in packet::Epoch::epochs(
             packet::Epoch::Initial..=packet::Epoch::Application,
         ) {
